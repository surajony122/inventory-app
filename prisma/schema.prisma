// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator         Boolean?  @default(false)
  emailVerified        Boolean?  @default(false)
  refreshToken         String?
  refreshTokenExpires  DateTime?
}

model OrderWorkflow {
  id            String   @id // Shopify Order ID
  status        String   @default("Awaiting Inventory Check")
  owner         String   @default("Inventory - Queue")
  note          String?
  handoffs      String   @default("[]") // JSON string of handoff history
  updatedAt     DateTime @updatedAt
}

model Inventory {
  id            String   @id // Variant ID
  sku           String?
  quantity      Int      @default(0)
  binLocation   String?
  notes         String?
  updatedAt     DateTime @updatedAt
}

model OrderCache {
  id            String   @id // Shopify Order GID
  name          String   // e.g., #1001
  customer      String?
  item          String?
  sku           String?
  qty           Int      @default(1)
  imageUrl      String?
  orderDate     String?
  createdAt     String?  // ISO string for aging calc
  paymentStatus String?
  priority      String   @default("Medium")
  shopifyNote   String?
  tags          String?  // Comma-separated list of order tags
  updatedAt     DateTime @updatedAt
}

model WorkflowUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  access    String   // JSON string of roles, e.g., '["admin", "inventory"]'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())
}


model CheckoutBlock {
  id        String   @id @default(cuid())
  kind      String   // "coupon" | "note"
  title     String
  body      String?
  code      String?  // discount code, coupons only
  condType  String   @default("always") // "always" | "tag" | "collection"
  condValue String?  // comma-separated tags or collection handles
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pinned products on collection pages for ad visitors.
// A visit whose utm_campaign / utm_content contains `keyword` sees `handles` first on the collection page.
model AdPinRule {
  id         String   @id @default(cuid())
  keyword    String   // matched (contains, case-insensitive) against utm_campaign / utm_content
  handles    String   // comma-separated product handles, in the order to show them
  collection String?  // optional: only apply on this collection handle
  active     Boolean  @default(true)
  source     String   @default("manual") // "manual" | "meta"
  note       String?
  // Auto mode: the product list is recomputed live from store data instead of typed by hand
  mode        String    @default("manual") // "manual" | "auto"
  metric      String    @default("orders") // orders | units | revenue | views | carts
  windowDays  Int       @default(7)
  topN        Int       @default(16)
  scope       String    @default("ad")     // "ad" = only visitors/orders from this ad, "collection" = everyone
  refreshedAt DateTime?
  autoNote    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
